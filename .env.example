# ---------------------------------------------------------------------------
# Listeners
# ---------------------------------------------------------------------------
# gRPC listen address for this service. Default: :50057
GRPC_LISTEN_ADDR=:50057

# REST/JSON listen address for the built-in grpc-gateway, which transcodes
# GaragesGatewayService's REST surface to gRPC. Default: :8083
GATEWAY_LISTEN_ADDR=:8083

# ---------------------------------------------------------------------------
# Upstreams
# ---------------------------------------------------------------------------
# GraphQL endpoint of the garages CMS (autofik.dev.api.garages.cms), including
# the /graphql path. Its resolvers have no auth of their own, so this must be
# an internal address. Default: http://localhost:4042/graphql
GARAGE_CMS_SERVICE_URL=http://localhost:4042/graphql

# Base URL of the garage SSO (autofik.dev.api.sso.garage), which verifies the
# bearer token on every RPC but the health checks. Not the user SSO the SOS
# and billing gateways call: that one knows no garage tokens. Use an internal
# address. Default: http://localhost:4000
SSO_GARAGE_SERVICE_URL=http://localhost:4000
# The whole verify-token URL; set only if it moves off the default path.
# Default: SSO_GARAGE_SERVICE_URL + /api/garage/verify-token
# SSO_GARAGE_VERIFY_URL=http://localhost:4000/api/garage/verify-token

# ---------------------------------------------------------------------------
# Timeouts
# ---------------------------------------------------------------------------
# Hard deadline applied to every RPC when the caller supplies none. Default: 15
REQUEST_TIMEOUT_SECONDS=15

# Per-call limit on verify-token, as a Go duration (same name and meaning as
# the SOS and billing gateways). verify-token answers in about 2s on testing.
# It spends from REQUEST_TIMEOUT_SECONDS before the CMS call does, and a call
# that gets no answer is retried once when the request has room for it.
# Default: 3s
SSO_VERIFY_TIMEOUT=3s

# Per-call timeout for requests to the CMS. Keep it below
# REQUEST_TIMEOUT_SECONDS. Default: 10
HTTP_CLIENT_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Observability and debugging
# ---------------------------------------------------------------------------
# debug | info | warn | error. Default: info
LOG_LEVEL=info
# json | text. Default: json
LOG_FORMAT=json

# gRPC server reflection enumerates the entire API surface to anyone who can
# reach the port. Leave unset in production; enable locally for grpcurl.
GRPC_ENABLE_REFLECTION=

# ---------------------------------------------------------------------------
# Docker image (Makefile only)
# ---------------------------------------------------------------------------
IMAGE_NAME=dev.api.garages.getway
IMAGE_TAG=latest
DOCKER_USERNAME_TAG=
DOCKER_USERNAME_LOGIN=
DOCKER_TOKEN=
